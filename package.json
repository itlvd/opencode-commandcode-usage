{
  "name": "@itlvd/opencode-commandcode-usage",
  "version": "0.1.1",
  "description": "Standalone Command Code provider and quota dashboard for OpenCode V2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:host": "tsx tests/host-smoke.ts",
    "test:tui": "bun --preload @opentui/solid/preload tests/tui-smoke.tsx",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "validate": "npm run check && npm run test:host && npm run test:package"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.19",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/sdk": "2.0.19",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itlvd/opencode-commandcode-usage.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
